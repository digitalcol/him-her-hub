# Site
SITE_URL=
# Production must be false. The local sandbox may set true.
PREVIEW_MODE=false

# Database. Required outside the local sandbox. Never a client variable.
DATABASE_URL=

# Supabase. Service role stays on the server. Do not prefix it with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=

# Bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instagram. Server only.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=
